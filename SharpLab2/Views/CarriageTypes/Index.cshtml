@model IEnumerable<SharpLab2.Models.CarriageType>

@{
    ViewData["Title"] = "Типи вагонів";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Типи вагонів</h2>
        <p class="text-muted mb-0">Довідник категорій комфорту та встановлених доплат</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Додати тип вагона</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle border">
        <thead class="table-light">
            <tr>
                <th style="width: 50px;">#</th>
                <th>Категорія вагона</th>
                <th>Доплата за категорію</th>
                <th class="text-end" style="width: 220px;">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Id</td>
                    <td class="fw-semibold">@item.TypeName</td>
                    <td class="fw-bold text-success">@item.Surcharge.ToString("F2") грн</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Редагувати</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
