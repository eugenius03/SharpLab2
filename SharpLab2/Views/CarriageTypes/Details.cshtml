@model SharpLab2.Models.CarriageType

@{
    ViewData["Title"] = "Деталі типу вагона";
}

<h2>Тип вагона: @Model.TypeName</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Категорія вагона</dt>
        <dd class="col-sm-9">@Model.TypeName</dd>

        <dt class="col-sm-3">Встановлена доплата</dt>
        <dd class="col-sm-9 fw-bold text-success">@Model.Surcharge.ToString("F2") грн</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
    <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
</div>
