@model SharpLab2.Models.CarriageType

@{
    ViewData["Title"] = "Редагувати тип вагона";
}

<h2>Редагувати тип вагона: @Model.TypeName</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="TypeName" class="control-label">Назва категорії</label>
                <input asp-for="TypeName" class="form-control" />
                <span asp-validation-for="TypeName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Surcharge" class="control-label">Доплата за категорію (грн)</label>
                <input asp-for="Surcharge" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Surcharge" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Зберегти" class="btn btn-warning" />
                <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
            </div>
        </form>
    </div>
</div>
