<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Резервування квитків</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="d-flex flex-column min-vh-100 bg-white">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-4">
            <div class="container-fluid px-md-5 px-3">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Резервування квитків</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between" id="navbarContent">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Головна</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Tickets" asp-action="Index">Квитки</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Passengers" asp-action="Index">Пасажири</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Trains" asp-action="Index">Поїзди</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Destinations" asp-action="Index">Пункти призначення</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="CarriageTypes" asp-action="Index">Типи вагонів</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-md-5 px-3 flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-auto bg-light">
        <div class="container-fluid px-md-5 px-3">
            &copy; 2026 - Лабораторна робота №3 - ASP.NET Core MVC
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
