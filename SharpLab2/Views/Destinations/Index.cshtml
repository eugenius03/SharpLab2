@model IEnumerable<SharpLab2.Models.Destination>

@{
    ViewData["Title"] = "Пункти призначення";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Список пунктів призначення</h2>
        <p class="text-muted mb-0">Станції, відстані та базові тарифи</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Додати пункт</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle border">
        <thead class="table-light">
            <tr>
                <th style="width: 50px;">#</th>
                <th>Назва станції</th>
                <th>Відстань</th>
                <th>Базовий тариф</th>
                <th class="text-center" style="width: 150px;">Кількість поїздів</th>
                <th class="text-end" style="width: 220px;">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Id</td>
                    <td class="fw-semibold">@item.Name</td>
                    <td>@item.DistanceKm км</td>
                    <td>@item.BaseFare.ToString("F2") грн</td>
                    <td class="text-center">
                        <span class="badge bg-secondary">@item.Trains.Count</span>
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Редагувати</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
