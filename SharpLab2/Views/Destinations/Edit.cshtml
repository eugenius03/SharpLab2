@model SharpLab2.Models.Destination

@{
    ViewData["Title"] = "Редагувати пункт призначення";
}

<h2>Редагувати пункт призначення</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">Назва станції</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DistanceKm" class="control-label">Відстань (км)</label>
                <input asp-for="DistanceKm" class="form-control" type="number" step="1" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BaseFare" class="control-label">Базовий тариф (грн)</label>
                <input asp-for="BaseFare" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="BaseFare" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Зберегти" class="btn btn-warning" />
                <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
            </div>
        </form>
    </div>
</div>
