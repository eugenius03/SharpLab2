@model SharpLab2.Models.Destination

@{
    ViewData["Title"] = "Видалити пункт призначення";
}

<h2>Видалення пункту призначення</h2>

<h3>Ви впевнені, що бажаєте видалити цей запис?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Назва станції</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Відстань від Чернівців</dt>
        <dd class="col-sm-9">@Model.DistanceKm км</dd>

        <dt class="col-sm-3">Базовий тариф</dt>
        <dd class="col-sm-9">@Model.BaseFare грн</dd>

        <dt class="col-sm-3">Кількість рейсів</dt>
        <dd class="col-sm-9">@Model.Trains.Count</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
    </form>
</div>
