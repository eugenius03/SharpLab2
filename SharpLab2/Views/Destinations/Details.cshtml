@model SharpLab2.Models.Destination

@{
    ViewData["Title"] = "Деталі пункту призначення";
}

<h2>Станція: @Model.Name</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Назва станції</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Відстань від Чернівців</dt>
        <dd class="col-sm-9">@Model.DistanceKm км</dd>

        <dt class="col-sm-3">Базовий тариф</dt>
        <dd class="col-sm-9">@Model.BaseFare грн</dd>
    </dl>
</div>

<h4>Поїзди, що прямують до станції (@Model.Trains.Count)</h4>
@if (Model.Trains.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Номер поїзда</th>
                <th>Тип</th>
                <th>Відправлення</th>
                <th>Прибуття</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var train in Model.Trains)
            {
                <tr>
                    <td>@train.Id</td>
                    <td>@train.TrainNumber</td>
                    <td>@train.TrainType</td>
                    <td>@train.DepartureTime</td>
                    <td>@train.ArrivalTime</td>
                    <td>
                        <a asp-controller="Trains" asp-action="Details" asp-route-id="@train.Id">Деталі поїзда</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Немає рейсів до цього пункту призначення.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
    <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
</div>
