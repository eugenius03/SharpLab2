@model IEnumerable<SharpLab2.Models.Passenger>

@{
    ViewData["Title"] = "Пасажири";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Список пасажирів</h2>
        <p class="text-muted mb-0">Контактні дані та кількість куплених квитків</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Додати пасажира</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle border">
        <thead class="table-light">
            <tr>
                <th style="width: 50px;">#</th>
                <th>ПІБ пасажира</th>
                <th>Домашня адреса</th>
                <th>Номер телефону</th>
                <th class="text-center" style="width: 150px;">Квитків</th>
                <th class="text-end" style="width: 220px;">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Id</td>
                    <td class="fw-semibold">@item.FullName</td>
                    <td>@item.Address</td>
                    <td>@item.Phone</td>
                    <td class="text-center">
                        <span class="badge bg-secondary">@item.Tickets.Count</span>
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Редагувати</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
