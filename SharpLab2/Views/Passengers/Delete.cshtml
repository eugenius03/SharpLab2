@model SharpLab2.Models.Passenger

@{
    ViewData["Title"] = "Видалити пасажира";
}

<h2>Видалення пасажира</h2>

<h3>Ви впевнені, що бажаєте видалити цей запис?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ПІБ</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Адреса</dt>
        <dd class="col-sm-9">@Model.Address</dd>

        <dt class="col-sm-3">Телефон</dt>
        <dd class="col-sm-9">@Model.Phone</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
    </form>
</div>
