@model SharpLab2.Models.Ticket

@{
    ViewData["Title"] = "Видалити квиток";
}

<h2>Видалення квитка</h2>

<h3>Ви впевнені, що бажаєте видалити цей запис?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Номер квитка</dt>
        <dd class="col-sm-9">#@Model.Id</dd>

        <dt class="col-sm-3">Пасажир</dt>
        <dd class="col-sm-9">@Model.Passenger?.FullName</dd>

        <dt class="col-sm-3">Поїзд</dt>
        <dd class="col-sm-9">@Model.Train?.TrainNumber (@Model.Train?.Destination?.Name)</dd>

        <dt class="col-sm-3">Дата відправлення</dt>
        <dd class="col-sm-9">@Model.DepartureDate</dd>

        <dt class="col-sm-3">Вагон / Тип</dt>
        <dd class="col-sm-9">№@Model.CarriageNumber (@Model.CarriageType?.TypeName)</dd>

        <dt class="col-sm-3">Сума до сплати</dt>
        <dd class="col-sm-9"><strong>@Model.GetTotalPrice() грн</strong></dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
    </form>
</div>
