@model SharpLab2.Models.Ticket

@{
    ViewData["Title"] = "Оформити квиток";
}

<h2>Оформити новий квиток</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="PassengerId" class="control-label">Пасажир</label>
                <select asp-for="PassengerId" class="form-control" asp-items="ViewBag.PassengerId"></select>
                <span asp-validation-for="PassengerId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TrainId" class="control-label">Поїзд</label>
                <select asp-for="TrainId" class="form-control" asp-items="ViewBag.TrainId"></select>
                <span asp-validation-for="TrainId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CarriageTypeId" class="control-label">Тип вагона</label>
                <select asp-for="CarriageTypeId" class="form-control" asp-items="ViewBag.CarriageTypeId"></select>
                <span asp-validation-for="CarriageTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CarriageNumber" class="control-label">Номер вагона</label>
                <input asp-for="CarriageNumber" class="form-control" type="number" min="1" max="25" />
                <span asp-validation-for="CarriageNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DepartureDate" class="control-label">Дата відправлення</label>
                <input asp-for="DepartureDate" class="form-control" type="date" />
                <span asp-validation-for="DepartureDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="UrgencySurcharge" class="control-label">Доплата за терміновість (грн)</label>
                <input asp-for="UrgencySurcharge" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="UrgencySurcharge" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Створити" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
            </div>
        </form>
    </div>
</div>
