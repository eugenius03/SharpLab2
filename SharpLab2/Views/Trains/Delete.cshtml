@model SharpLab2.Models.Train

@{
    ViewData["Title"] = "Видалити поїзд";
}

<h2>Видалення поїзда</h2>

<h3>Ви впевнені, що бажаєте видалити цей запис?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Номер поїзда</dt>
        <dd class="col-sm-9">@Model.TrainNumber</dd>

        <dt class="col-sm-3">Тип</dt>
        <dd class="col-sm-9">@Model.TrainType</dd>

        <dt class="col-sm-3">Пункт призначення</dt>
        <dd class="col-sm-9">@Model.Destination?.Name</dd>

        <dt class="col-sm-3">Час відправлення</dt>
        <dd class="col-sm-9">@Model.DepartureTime</dd>

        <dt class="col-sm-3">Час прибуття</dt>
        <dd class="col-sm-9">@Model.ArrivalTime</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
    </form>
</div>
