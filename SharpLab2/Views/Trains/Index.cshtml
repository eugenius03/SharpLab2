@model IEnumerable<SharpLab2.Models.Train>

@{
    ViewData["Title"] = "Поїзди";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Список поїздів</h2>
        <p class="text-muted mb-0">Розклад та маршрути рейсів</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Додати поїзд</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle border">
        <thead class="table-light">
            <tr>
                <th style="width: 50px;">#</th>
                <th>Номер поїзда</th>
                <th>Тип</th>
                <th>Пункт призначення</th>
                <th>Час відправлення</th>
                <th>Час прибуття</th>
                <th class="text-center" style="width: 120px;">Квитків</th>
                <th class="text-end" style="width: 220px;">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Id</td>
                    <td class="fw-semibold">@item.TrainNumber</td>
                    <td>@item.TrainType</td>
                    <td>@item.Destination?.Name (@item.Destination?.DistanceKm км)</td>
                    <td>@item.DepartureTime</td>
                    <td>@item.ArrivalTime</td>
                    <td class="text-center">
                        <span class="badge bg-secondary">@item.Tickets.Count</span>
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Редагувати</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
