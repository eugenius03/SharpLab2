@model SharpLab2.Models.Train

@{
    ViewData["Title"] = "Деталі поїзда";
}

<h2>Поїзд №@Model.TrainNumber</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Номер поїзда</dt>
        <dd class="col-sm-9">@Model.TrainNumber</dd>

        <dt class="col-sm-3">Тип поїзда</dt>
        <dd class="col-sm-9">@Model.TrainType</dd>

        <dt class="col-sm-3">Пункт призначення</dt>
        <dd class="col-sm-9">@Model.Destination?.Name (@Model.Destination?.DistanceKm км)</dd>

        <dt class="col-sm-3">Час відправлення / прибуття</dt>
        <dd class="col-sm-9">@Model.DepartureTime — @Model.ArrivalTime</dd>
    </dl>
</div>

<h4>Квитки на цей рейс (@Model.Tickets.Count)</h4>
@if (Model.Tickets.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Пасажир</th>
                <th>Дата</th>
                <th>Вагон</th>
                <th>Сума</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.Tickets)
            {
                <tr>
                    <td>@ticket.Id</td>
                    <td>@ticket.Passenger?.FullName</td>
                    <td>@ticket.DepartureDate</td>
                    <td>№@ticket.CarriageNumber</td>
                    <td>@ticket.GetTotalPrice() грн</td>
                    <td>
                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">Деталі квитка</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Немає заброньованих квитків.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
    <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
</div>
