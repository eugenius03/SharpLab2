@page "/carriagetypes"
@using SharpLab2.Models
@using SharpLab2.Services
@inject ICarriageTypeService CarriageTypeService

<PageTitle>Типи вагонів - Резервування квитків</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Типи вагонів</h2>
        <p class="text-muted mb-0">Довідник категорій комфорту та встановлених доплат</p>
    </div>
    <a class="btn btn-primary" href="carriagetypes/create">Додати тип вагона</a>
</div>

@if (carriageTypes == null)
{
    <div class="alert alert-info">Завантаження даних...</div>
}
else if (carriageTypes.Count == 0)
{
    <div class="alert alert-warning">Типів вагонів ще немає. <a href="carriagetypes/create">Додати перший тип вагона</a>.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Категорія вагона</th>
                    <th>Доплата за категорію</th>
                    <th class="text-end" style="width: 220px;">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in carriageTypes)
                {
                    <tr>
                        <td class="fw-bold">@item.Id</td>
                        <td class="fw-semibold">@item.TypeName</td>
                        <td class="fw-bold text-success">@item.Surcharge.ToString("F2") грн</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary me-1" href="carriagetypes/edit/@item.Id">Редагувати</a>
                            <a class="btn btn-sm btn-outline-info me-1" href="carriagetypes/details/@item.Id">Деталі</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(item)">Видалити</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (typeToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Підтвердження видалення</h5>
                    <button type="button" class="btn-close" @onclick="() => typeToDelete = null"></button>
                </div>
                <div class="modal-body">
                    Ви дійсно бажаєте видалити тип вагона <strong>@typeToDelete.TypeName</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => typeToDelete = null">Скасувати</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync">Видалити</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CarriageType>? carriageTypes;
    private CarriageType? typeToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadCarriageTypesAsync();
    }

    private async Task LoadCarriageTypesAsync()
    {
        carriageTypes = await CarriageTypeService.GetAllAsync();
    }

    private void RequestDelete(CarriageType ct)
    {
        typeToDelete = ct;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (typeToDelete != null)
        {
            await CarriageTypeService.DeleteAsync(typeToDelete.Id);
            typeToDelete = null;
            await LoadCarriageTypesAsync();
        }
    }
}
