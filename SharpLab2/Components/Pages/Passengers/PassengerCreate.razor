@page "/passengers/create"
@using SharpLab2.Models
@using SharpLab2.Services
@inject IPassengerService PassengerService
@inject NavigationManager Navigation

<PageTitle>Додати пасажира - Резервування квитків</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-person-plus me-2"></i>Додати нового пасажира</h4>
            </div>
            <div class="card-body p-4">
                <EditForm Model="passenger" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">ПІБ</label>
                        <InputText class="form-control" @bind-Value="passenger.FullName" placeholder="Прізвище Ім'я По батькові" />
                        <ValidationMessage For="@(() => passenger.FullName)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Адреса</label>
                        <InputText class="form-control" @bind-Value="passenger.Address" placeholder="Місто, вулиця, будинок" />
                        <ValidationMessage For="@(() => passenger.Address)" class="text-danger small" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Номер телефону</label>
                        <InputText class="form-control" @bind-Value="passenger.Phone" placeholder="+380..." />
                        <ValidationMessage For="@(() => passenger.Phone)" class="text-danger small" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a class="btn btn-outline-secondary" href="passengers">
                            <i class="bi bi-arrow-left me-1"></i> Скасувати
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle me-1"></i> Створити
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private Passenger passenger = new();

    private async Task HandleValidSubmit()
    {
        await PassengerService.CreateAsync(passenger);
        Navigation.NavigateTo("passengers");
    }
}
