@page "/passengers/edit/{id:int}"
@using SharpLab2.Models
@using SharpLab2.HubClients
@inject IPassengerHubClient PassengerClient
@inject NavigationManager Navigation

<PageTitle>Редагувати пасажира - Резервування квитків</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Редагування пасажира №@Id</h4>
            </div>
            <div class="card-body p-4">
                @if (passenger == null)
                {
                    <div class="alert alert-info">Завантаження даних...</div>
                }
                else
                {
                    @if (errorMessage != null)
                    {
                        <div class="alert alert-warning">@errorMessage <a href="passengers">Повернутися до списку</a>.</div>
                    }

                    <EditForm Model="passenger" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">ПІБ</label>
                            <InputText class="form-control" @bind-Value="passenger.FullName" />
                            <ValidationMessage For="@(() => passenger.FullName)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Адреса</label>
                            <InputText class="form-control" @bind-Value="passenger.Address" />
                            <ValidationMessage For="@(() => passenger.Address)" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Номер телефону</label>
                            <InputText class="form-control" @bind-Value="passenger.Phone" />
                            <ValidationMessage For="@(() => passenger.Phone)" class="text-danger small" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a class="btn btn-outline-secondary" href="passengers">
                                <i class="bi bi-arrow-left me-1"></i> Скасувати
                            </a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-save me-1"></i> Зберегти
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Passenger? passenger;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        passenger = await PassengerClient.GetByIdAsync(Id);
        if (passenger == null)
        {
            Navigation.NavigateTo("passengers");
        }
    }

    private async Task HandleValidSubmit()
    {
        if (passenger != null)
        {
            if (!await PassengerClient.TryUpdateAsync(passenger))
            {
                errorMessage = "Не вдалося зберегти зміни: цей запис уже видалено або він не існує.";
                return;
            }

            Navigation.NavigateTo("passengers");
        }
    }
}
