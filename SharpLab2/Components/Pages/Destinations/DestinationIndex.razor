@page "/destinations"
@using SharpLab2.Models
@using SharpLab2.Services
@inject IDestinationService DestinationService

<PageTitle>Пункти призначення - Резервування квитків</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Список пунктів призначення</h2>
        <p class="text-muted mb-0">Станції, відстані та базові тарифи</p>
    </div>
    <a class="btn btn-primary" href="destinations/create">Додати пункт</a>
</div>

@if (destinations == null)
{
    <div class="alert alert-info">Завантаження даних...</div>
}
else if (destinations.Count == 0)
{
    <div class="alert alert-warning">Пунктів призначення ще немає. <a href="destinations/create">Додати перший пункт</a>.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Назва станції</th>
                    <th>Відстань</th>
                    <th>Базовий тариф</th>
                    <th class="text-center" style="width: 150px;">Кількість поїздів</th>
                    <th class="text-end" style="width: 220px;">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in destinations)
                {
                    <tr>
                        <td class="fw-bold">@item.Id</td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@item.DistanceKm км</td>
                        <td>@item.BaseFare.ToString("F2") грн</td>
                        <td class="text-center">
                            <span class="badge bg-secondary">@item.Trains.Count</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary me-1" href="destinations/edit/@item.Id">Редагувати</a>
                            <a class="btn btn-sm btn-outline-info me-1" href="destinations/details/@item.Id">Деталі</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(item)">Видалити</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (destinationToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Підтвердження видалення</h5>
                    <button type="button" class="btn-close" @onclick="() => destinationToDelete = null"></button>
                </div>
                <div class="modal-body">
                    Ви дійсно бажаєте видалити станцію <strong>@destinationToDelete.Name</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => destinationToDelete = null">Скасувати</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync">Видалити</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Destination>? destinations;
    private Destination? destinationToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadDestinationsAsync();
    }

    private async Task LoadDestinationsAsync()
    {
        destinations = await DestinationService.GetAllAsync();
    }

    private void RequestDelete(Destination d)
    {
        destinationToDelete = d;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (destinationToDelete != null)
        {
            await DestinationService.DeleteAsync(destinationToDelete.Id);
            destinationToDelete = null;
            await LoadDestinationsAsync();
        }
    }
}
