@page "/destinations/create"
@using SharpLab2.Models
@using SharpLab2.Services
@inject IDestinationService DestinationService
@inject NavigationManager Navigation

<PageTitle>Додати станцію - Резервування квитків</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Додати нову станцію</h4>
            </div>
            <div class="card-body p-4">
                <EditForm Model="destination" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Назва станції / міста</label>
                        <InputText class="form-control" @bind-Value="destination.Name" placeholder="Наприклад: Львів, Одеса, Харків..." />
                        <ValidationMessage For="@(() => destination.Name)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Відстань (км)</label>
                        <InputNumber min="1" class="form-control" @bind-Value="destination.DistanceKm" />
                        <ValidationMessage For="@(() => destination.DistanceKm)" class="text-danger small" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Базовий тариф (грн)</label>
                        <InputNumber min="0.01" step="0.01" class="form-control" @bind-Value="destination.BaseFare" />
                        <ValidationMessage For="@(() => destination.BaseFare)" class="text-danger small" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a class="btn btn-outline-secondary" href="destinations">
                            <i class="bi bi-arrow-left me-1"></i> Скасувати
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle me-1"></i> Створити
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private Destination destination = new();

    private async Task HandleValidSubmit()
    {
        await DestinationService.CreateAsync(destination);
        Navigation.NavigateTo("destinations");
    }
}
