@page "/destinations/edit/{id:int}"
@using SharpLab2.Models
@using SharpLab2.HubClients
@inject IDestinationHubClient DestinationClient
@inject NavigationManager Navigation

<PageTitle>Редагувати станцію - Резервування квитків</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Редагування станції №@Id</h4>
            </div>
            <div class="card-body p-4">
                @if (destination == null)
                {
                    <div class="alert alert-info">Завантаження даних...</div>
                }
                else
                {
                    @if (errorMessage != null)
                    {
                        <div class="alert alert-warning">@errorMessage <a href="destinations">Повернутися до списку</a>.</div>
                    }

                    <EditForm Model="destination" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Назва станції / міста</label>
                            <InputText class="form-control" @bind-Value="destination.Name" />
                            <ValidationMessage For="@(() => destination.Name)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Відстань (км)</label>
                            <InputNumber class="form-control" @bind-Value="destination.DistanceKm" />
                            <ValidationMessage For="@(() => destination.DistanceKm)" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Базовий тариф (грн)</label>
                            <InputNumber class="form-control" @bind-Value="destination.BaseFare" />
                            <ValidationMessage For="@(() => destination.BaseFare)" class="text-danger small" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a class="btn btn-outline-secondary" href="destinations">
                                <i class="bi bi-arrow-left me-1"></i> Скасувати
                            </a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-save me-1"></i> Зберегти
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Destination? destination;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        destination = await DestinationClient.GetByIdAsync(Id);
        if (destination == null)
        {
            Navigation.NavigateTo("destinations");
        }
    }

    private async Task HandleValidSubmit()
    {
        if (destination != null)
        {
            if (!await DestinationClient.TryUpdateAsync(destination))
            {
                errorMessage = "Не вдалося зберегти зміни: цей запис уже видалено або він не існує.";
                return;
            }

            Navigation.NavigateTo("destinations");
        }
    }
}
