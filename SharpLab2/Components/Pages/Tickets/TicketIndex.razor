@page "/tickets"
@using SharpLab2.Models
@using SharpLab2.Services
@inject ITicketService TicketService

<PageTitle>Квитки - Резервування квитків</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Список зарезервованих квитків</h2>
        <p class="text-muted mb-0">Відображення інформації про рейси та розрахунок вартості</p>
    </div>
    <a href="tickets/create" class="btn btn-primary">Оформити новий квиток</a>
</div>

<div class="row g-2 align-items-center mb-3">
    <div class="col-md-6">
        <input type="text" class="form-control" placeholder="Пошук за пасажиром, поїздом або пунктом призначення..." @bind="searchTerm" @bind:event="oninput" />
    </div>
    <div class="col-md-6 text-md-end text-muted">
        Всього квитків: <strong>@(FilteredTickets.Count)</strong> на суму <strong>@(FilteredTickets.Sum(t => t.GetTotalPrice()).ToString("F2")) грн</strong>
    </div>
</div>

@if (tickets == null)
{
    <div class="alert alert-info">Завантаження даних...</div>
}
else if (tickets.Count == 0)
{
    <div class="alert alert-warning">Квитків ще немає. <a href="tickets/create">Оформити перший квиток</a>.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-light">
                <tr>
                    <th style="width: 45px;">#</th>
                    <th>Пасажир</th>
                    <th>Рейс і напрямок</th>
                    <th>Вагон</th>
                    <th>Дата відправлення</th>
                    <th>Тарифи та доплати</th>
                    <th>До сплати</th>
                    <th class="text-end" style="width: 220px;">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredTickets)
                {
                    <tr>
                        <td class="fw-bold">@item.Id</td>
                        <td>
                            <div class="fw-semibold">@item.Passenger?.FullName</div>
                            <div class="small text-muted">@item.Passenger?.Phone</div>
                            <div class="small text-muted">@item.Passenger?.Address</div>
                        </td>
                        <td>
                            <div class="fw-semibold">Поїзд @item.Train?.TrainNumber (@item.Train?.TrainType) &rarr; @item.Train?.Destination?.Name</div>
                            <div class="small text-muted">Час: @item.Train?.DepartureTime – @item.Train?.ArrivalTime &middot; @item.Train?.Destination?.DistanceKm км</div>
                        </td>
                        <td>
                            <div>№@item.CarriageNumber</div>
                            <div class="small text-muted">@item.CarriageType?.TypeName</div>
                        </td>
                        <td>
                            <div>@item.DepartureDate</div>
                        </td>
                        <td>
                            <div class="small text-muted">Базовий тариф: @item.Train?.Destination?.BaseFare.ToString("F2") грн</div>
                            <div class="small text-muted">Терміновість: +@item.UrgencySurcharge.ToString("F2") грн</div>
                            <div class="small text-muted">Тип вагона: +@item.CarriageType?.Surcharge.ToString("F2") грн</div>
                        </td>
                        <td>
                            <span class="fw-bold text-success">@item.GetTotalPrice().ToString("F2") грн</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a href="tickets/edit/@item.Id" class="btn btn-sm btn-outline-secondary me-1">Редагувати</a>
                            <a href="tickets/details/@item.Id" class="btn btn-sm btn-outline-info me-1">Деталі</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(item)">Видалити</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (ticketToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Підтвердження видалення</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Ви дійсно бажаєте видалити квиток <strong>№@ticketToDelete.Id</strong>?</p>
                    <p class="mb-0">Пасажир: <strong>@ticketToDelete.Passenger?.FullName</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Скасувати</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Видалити</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Ticket>? tickets;
    private string searchTerm = string.Empty;
    private Ticket? ticketToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadTicketsAsync();
    }

    private async Task LoadTicketsAsync()
    {
        tickets = await TicketService.GetAllAsync();
    }

    private List<Ticket> FilteredTickets =>
        tickets == null
            ? []
            : string.IsNullOrWhiteSpace(searchTerm)
                ? tickets
                : tickets.Where(t =>
                    (t.Passenger?.FullName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.Train?.TrainNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.Train?.Destination?.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                ).ToList();

    private void RequestDelete(Ticket ticket)
    {
        ticketToDelete = ticket;
    }

    private void CancelDelete()
    {
        ticketToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (ticketToDelete != null)
        {
            await TicketService.DeleteAsync(ticketToDelete.Id);
            ticketToDelete = null;
            await LoadTicketsAsync();
        }
    }
}
