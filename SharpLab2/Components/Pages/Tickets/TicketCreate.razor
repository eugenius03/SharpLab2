@page "/tickets/create"
@using SharpLab2.Models
@using SharpLab2.Services
@inject ITicketService TicketService
@inject IPassengerService PassengerService
@inject ITrainService TrainService
@inject ICarriageTypeService CarriageTypeService
@inject NavigationManager Navigation

<PageTitle>Оформлення квитка - Резервування квитків</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-ticket-perforated me-2"></i>Оформлення нового квитка</h4>
            </div>
            <div class="card-body p-4">
                <EditForm Model="ticket" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Пасажир</label>
                        <select class="form-select" @bind="ticket.PassengerId">
                            <option value="0">-- Оберіть пасажира --</option>
                            @if (passengers != null)
                            {
                                @foreach (var p in passengers)
                                {
                                    <option value="@p.Id">@p.FullName (@p.Phone)</option>
                                }
                            }
                        </select>
                        <ValidationMessage For="@(() => ticket.PassengerId)" class="text-danger small" />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Потяг та напрямок</label>
                            <select class="form-select" @bind="ticket.TrainId">
                                <option value="0">-- Оберіть потяг --</option>
                                @if (trains != null)
                                {
                                    @foreach (var tr in trains)
                                    {
                                        <option value="@tr.Id">№@tr.TrainNumber (@tr.TrainType) - @tr.Destination?.Name (@tr.Destination?.DistanceKm км)</option>
                                    }
                                }
                            </select>
                            <ValidationMessage For="@(() => ticket.TrainId)" class="text-danger small" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Тип вагона</label>
                            <select class="form-select" @bind="ticket.CarriageTypeId">
                                <option value="0">-- Оберіть тип вагона --</option>
                                @if (carriageTypes != null)
                                {
                                    @foreach (var ct in carriageTypes)
                                    {
                                        <option value="@ct.Id">@ct.TypeName (+@ct.Surcharge.ToString("N2") грн)</option>
                                    }
                                }
                            </select>
                            <ValidationMessage For="@(() => ticket.CarriageTypeId)" class="text-danger small" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Номер вагона (1-30)</label>
                            <InputNumber min="1" max="30" class="form-control" @bind-Value="ticket.CarriageNumber" />
                            <ValidationMessage For="@(() => ticket.CarriageNumber)" class="text-danger small" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Дата відправлення</label>
                            <InputText type="date" class="form-control" @bind-Value="ticket.DepartureDate" />
                            <ValidationMessage For="@(() => ticket.DepartureDate)" class="text-danger small" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Надбавка за терміновість (грн)</label>
                            <InputNumber min="0" step="0.01" class="form-control" @bind-Value="ticket.UrgencySurcharge" />
                            <ValidationMessage For="@(() => ticket.UrgencySurcharge)" class="text-danger small" />
                        </div>
                    </div>

                    <div class="card bg-light border-primary mb-4">
                        <div class="card-body">
                            <h6 class="card-title text-primary fw-bold mb-2">
                                <i class="bi bi-calculator me-1"></i> Попередній розрахунок вартості
                            </h6>
                            <div class="row text-center">
                                <div class="col-md-3">
                                    <small class="text-muted d-block">Базова ставка</small>
                                    <span class="fw-semibold">@(ticket.TrainId > 0 ? $"{SelectedTrainBaseFare:N2} грн" : "—")</span>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted d-block">Надбавка за тип вагона</small>
                                    <span class="fw-semibold">@(ticket.CarriageTypeId > 0 ? $"+{SelectedCarriageSurcharge:N2} грн" : "—")</span>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted d-block">Терміновість</small>
                                    <span class="fw-semibold">+@ticket.UrgencySurcharge.ToString("N2") грн</span>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted d-block">Разом до сплати</small>
                                    <span class="fs-5 fw-bold text-success">@(IsReadyForPriceCalc ? $"{EstimatedTotal:N2} грн" : "—")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a class="btn btn-outline-secondary" href="tickets">
                            <i class="bi bi-arrow-left me-1"></i> Назад до списку
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle me-1"></i> Підтвердити та оформити
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private Ticket ticket = new()
    {
        CarriageNumber = 1,
        DepartureDate = DateTime.Today.ToString("yyyy-MM-dd"),
        UrgencySurcharge = 0
    };

    private List<Passenger>? passengers;
    private List<Train>? trains;
    private List<CarriageType>? carriageTypes;

    protected override async Task OnInitializedAsync()
    {
        passengers = await PassengerService.GetAllAsync();
        trains = await TrainService.GetAllAsync();
        carriageTypes = await CarriageTypeService.GetAllAsync();
    }

    private decimal SelectedTrainBaseFare
    {
        get
        {
            var train = trains?.FirstOrDefault(t => t.Id == ticket.TrainId);
            return train?.Destination?.BaseFare ?? 0;
        }
    }

    private decimal SelectedCarriageSurcharge
    {
        get
        {
            var ct = carriageTypes?.FirstOrDefault(c => c.Id == ticket.CarriageTypeId);
            return ct?.Surcharge ?? 0;
        }
    }

    private bool IsReadyForPriceCalc => ticket is { TrainId: > 0, CarriageTypeId: > 0 };

    private decimal EstimatedTotal => SelectedTrainBaseFare + SelectedCarriageSurcharge + ticket.UrgencySurcharge;

    private async Task HandleValidSubmit()
    {
        await TicketService.CreateAsync(ticket);
        Navigation.NavigateTo("tickets");
    }
}
