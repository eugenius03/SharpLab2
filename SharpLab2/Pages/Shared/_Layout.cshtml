<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Резервування квитків</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="d-flex flex-column min-vh-100 bg-white">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-4">
            <div class="container-fluid px-md-5 px-3">
                <a class="navbar-brand fw-semibold" asp-page="/Index">Резервування квитків</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between" id="navbarContent">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Головна</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Tickets/Index">Квитки</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Passengers/Index">Пасажири</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Trains/Index">Поїзди</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Destinations/Index">Пункти призначення</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/CarriageTypes/Index">Типи вагонів</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-primary fw-semibold" href="#" id="apiDropdown" role="button" data-bs-toggle="dropdown">
                                Web API (JSON)
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/api/tickets" target="_blank">/api/tickets</a></li>
                                <li><a class="dropdown-item" href="/api/passengers" target="_blank">/api/passengers</a></li>
                                <li><a class="dropdown-item" href="/api/trains" target="_blank">/api/trains</a></li>
                                <li><a class="dropdown-item" href="/api/destinations" target="_blank">/api/destinations</a></li>
                                <li><a class="dropdown-item" href="/api/carriagetypes" target="_blank">/api/carriagetypes</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-md-5 px-3 flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-auto bg-light">
        <div class="container-fluid px-md-5 px-3">
            &copy; 2026 - Лабораторна робота №4 - ASP.NET Core Razor Pages & Web API
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
