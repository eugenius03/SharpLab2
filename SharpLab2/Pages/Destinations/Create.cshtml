@page
@model SharpLab2.Pages.Destinations.CreateModel
@{
    ViewData["Title"] = "Додати пункт призначення";
}

<h2>Додати пункт призначення</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Destination.Name" class="control-label">Назва станції</label>
                <input asp-for="Destination.Name" class="form-control" />
                <span asp-validation-for="Destination.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Destination.DistanceKm" class="control-label">Відстань (км)</label>
                <input asp-for="Destination.DistanceKm" class="form-control" type="number" step="1" />
                <span asp-validation-for="Destination.DistanceKm" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Destination.BaseFare" class="control-label">Базовий тариф (грн)</label>
                <input asp-for="Destination.BaseFare" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Destination.BaseFare" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Створити" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Назад до списку</a>
            </div>
        </form>
    </div>
</div>
