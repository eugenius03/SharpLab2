@page "{id:int}"
@model SharpLab2.Pages.Trains.DeleteModel
@{
    ViewData["Title"] = "Видалити поїзд";
}

<h2>Видалення поїзда</h2>

<h3>Ви впевнені, що бажаєте видалити цей запис?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Номер поїзда</dt>
        <dd class="col-sm-9">@Model.Train.TrainNumber</dd>

        <dt class="col-sm-3">Тип</dt>
        <dd class="col-sm-9">@Model.Train.TrainType</dd>

        <dt class="col-sm-3">Пункт призначення</dt>
        <dd class="col-sm-9">@Model.Train.Destination?.Name</dd>

        <dt class="col-sm-3">Час відправлення</dt>
        <dd class="col-sm-9">@Model.Train.DepartureTime</dd>

        <dt class="col-sm-3">Час прибуття</dt>
        <dd class="col-sm-9">@Model.Train.ArrivalTime</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Train.Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Назад до списку</a>
    </form>
</div>
