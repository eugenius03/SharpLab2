@page "{id:int}"
@model SharpLab2.Pages.CarriageTypes.EditModel
@{
    ViewData["Title"] = "Редагувати тип вагона";
}

<h2>Редагувати тип вагона: @Model.CarriageType.TypeName</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="CarriageType.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="CarriageType.TypeName" class="control-label">Назва категорії</label>
                <input asp-for="CarriageType.TypeName" class="form-control" />
                <span asp-validation-for="CarriageType.TypeName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CarriageType.Surcharge" class="control-label">Доплата за категорію (грн)</label>
                <input asp-for="CarriageType.Surcharge" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="CarriageType.Surcharge" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Зберегти" class="btn btn-warning" />
                <a asp-page="./Index" class="btn btn-secondary">Назад до списку</a>
            </div>
        </form>
    </div>
</div>
