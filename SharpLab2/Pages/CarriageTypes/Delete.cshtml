@page "{id:int}"
@model SharpLab2.Pages.CarriageTypes.DeleteModel
@{
    ViewData["Title"] = "Видалити тип вагона";
}

<h2>Видалення типу вагона</h2>

<h3>Ви впевнені, що бажаєте видалити цей запис?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Категорія вагона</dt>
        <dd class="col-sm-9">@Model.CarriageType.TypeName</dd>

        <dt class="col-sm-3">Встановлена доплата</dt>
        <dd class="col-sm-9 fw-bold text-success">@Model.CarriageType.Surcharge.ToString("F2") грн</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="CarriageType.Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Назад до списку</a>
    </form>
</div>
