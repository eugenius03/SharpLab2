@page "{id:int}"
@model SharpLab2.Pages.CarriageTypes.DetailsModel
@{
    ViewData["Title"] = "Деталі типу вагона";
}

<h2>Тип вагона: @Model.CarriageType?.TypeName</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Категорія вагона</dt>
        <dd class="col-sm-9">@Model.CarriageType?.TypeName</dd>

        <dt class="col-sm-3">Встановлена доплата</dt>
        <dd class="col-sm-9 fw-bold text-success">@Model.CarriageType?.Surcharge.ToString("F2") грн</dd>
    </dl>
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.CarriageType?.Id" class="btn btn-warning">Редагувати</a>
    <a asp-page="./Index" class="btn btn-secondary">Назад до списку</a>
</div>
