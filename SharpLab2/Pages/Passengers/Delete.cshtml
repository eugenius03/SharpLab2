@page "{id:int}"
@model SharpLab2.Pages.Passengers.DeleteModel
@{
    ViewData["Title"] = "Видалити пасажира";
}

<h2>Видалення пасажира</h2>

<h3>Ви впевнені, що бажаєте видалити цей запис?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ПІБ</dt>
        <dd class="col-sm-9">@Model.Passenger.FullName</dd>

        <dt class="col-sm-3">Адреса</dt>
        <dd class="col-sm-9">@Model.Passenger.Address</dd>

        <dt class="col-sm-3">Телефон</dt>
        <dd class="col-sm-9">@Model.Passenger.Phone</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Passenger.Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Назад до списку</a>
    </form>
</div>
