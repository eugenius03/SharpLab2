@page "{id:int}"
@model SharpLab2.Pages.Passengers.DetailsModel
@{
    ViewData["Title"] = "Картка пасажира";
}

<div class="mb-4">
    <h2>Картка пасажира: @Model.Passenger?.FullName</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ПІБ</dt>
        <dd class="col-sm-9">@Model.Passenger?.FullName</dd>

        <dt class="col-sm-3">Адреса проживання</dt>
        <dd class="col-sm-9">@Model.Passenger?.Address</dd>

        <dt class="col-sm-3">Номер телефону</dt>
        <dd class="col-sm-9">@Model.Passenger?.Phone</dd>

        <dt class="col-sm-3">Всього замовлень</dt>
        <dd class="col-sm-9 fw-bold">@Model.Passenger?.Tickets.Count</dd>
    </dl>
</div>

<div class="mb-4">
    <h4>Зарезервовані квитки</h4>
    @if (Model.Passenger?.Tickets.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle border">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Поїзд</th>
                        <th>Пункт призначення</th>
                        <th>Дата відправлення</th>
                        <th>Вагон</th>
                        <th>Тип вагона</th>
                        <th>Вартість</th>
                        <th class="text-end" style="width: 120px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model.Passenger.Tickets)
                    {
                        <tr>
                            <td>@ticket.Id</td>
                            <td>@ticket.Train?.TrainNumber (@ticket.Train?.TrainType)</td>
                            <td>@ticket.Train?.Destination?.Name</td>
                            <td>@ticket.DepartureDate</td>
                            <td>№@ticket.CarriageNumber</td>
                            <td>@ticket.CarriageType?.TypeName</td>
                            <td class="fw-semibold text-success">@ticket.GetTotalPrice().ToString("F2") грн</td>
                            <td class="text-end">
                                <a asp-page="/Tickets/Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-info">Деталі</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">У цього пасажира немає зарезервованих квитків.</p>
    }
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Passenger?.Id" class="btn btn-warning">Редагувати</a>
    <a asp-page="./Index" class="btn btn-secondary">Назад до списку</a>
</div>
